{
  "name": "@anglify/source",
  "scripts": {
    "ng": "nx",
    "release": "standard-version",
    "update": "yarn upgrade-interactive",
    "lint": "prettier --check . && stylelint \"**/*.scss\" && nx run-many --all --target=lint",
    "format": "prettier --write . && stylelint \"**/*.scss\" --fix && nx run-many --all --target=lint --fix",
    "prepare": "is-ci || husky install",
    "test": "nx run-many --all --target=test",
    "docs:start": "node ./scripts/css-variable-extractor.js && yarn run docs:generate-api && nx run docs:serve:development",
    "docs:build": "node ./scripts/css-variable-extractor.js && yarn run docs:generate-api && nx run docs:build:production",
    "docs:generate-api": "compodoc -p ./libs/anglify/tsconfig.json -e json -d ./apps/docs/src/assets",
    "anglify:test": "nx test --project=anglify",
    "anglify:test:coverage": "nx test --coverage --project=anglify",
    "anglify:build": "rimraf dist/ && nx run anglify:build:production --skip-nx-cache && cpy . '../' --cwd=dist/libs/anglify/src && rimraf dist/libs/anglify/src",
    "kitchensink:start": "nx run kitchensink:serve:development",
    "kitchensink:build": "nx run kitchensink:build:production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~18.2.0",
    "@angular/common": "~18.2.0",
    "@angular/compiler": "~18.2.0",
    "@angular/core": "~18.2.0",
    "@angular/elements": "~18.2.0",
    "@angular/forms": "~18.2.0",
    "@angular/platform-browser": "~18.2.0",
    "@angular/platform-browser-dynamic": "~18.2.0",
    "@angular/router": "~18.2.0",
    "@floating-ui/dom": "1.0.1",
    "@ngneat/until-destroy": "^10.0.0",
    "@nx/angular": "19.8.14",
    "@nx/eslint-plugin": "19.8.14",
    "@types/marked": "^4.0.6",
    "@types/prismjs": "^1.26.0",
    "common-tags": "^1.8.2",
    "deepmerge-ts": "^4.2.1",
    "highlight.js": "^11.6.0",
    "marked": "^4.1.0",
    "prismjs": "^1.29.0",
    "rxjs": "^7.5.6",
    "safevalues": "^0.3.1",
    "tslib": "^2.4.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.0",
    "@angular-devkit/core": "~18.2.0",
    "@angular-devkit/schematics": "~18.2.0",
    "@angular/cli": "~18.2.0",
    "@angular/compiler-cli": "~18.2.0",
    "@angular/language-service": "~18.2.0",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@compodoc/compodoc": "^1.1.19",
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@mdi/js": "^7.0.96",
    "@nx/eslint": "19.8.14",
    "@nx/jest": "19.8.14",
    "@nx/workspace": "19.8.14",
    "@schematics/angular": "~18.2.0",
    "@testing-library/angular": "^16.0.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@types/common-tags": "^1.8.1",
    "@types/jest": "29.5.14",
    "@types/node": "^18.7.14",
    "autoprefixer": "^10.4.0",
    "cpy-cli": "^4.2.0",
    "eslint": "8.57.1",
    "eslint-config-neon": "^0.1.33",
    "husky": "^8.0.1",
    "is-ci": "^3.0.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-preset-angular": "14.1.1",
    "ng-packagr": "~18.2.0",
    "nx": "19.8.14",
    "postcss": "^8.4.16",
    "postcss-import": "^14.1.0",
    "postcss-preset-env": "^7.8.0",
    "postcss-url": "^10.1.3",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.5.0",
    "stylelint": "^14.11.0",
    "stylelint-config-idiomatic-order": "^8.1.0",
    "stylelint-config-prettier-scss": "^0.0.1",
    "stylelint-config-standard-scss": "^5.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "10.9.1",
    "typescript": "~5.5.4"
  },
  "peerDependencies": {
    "@anx/workspace-tools": "^1.1.6"
  },
  "packageManager": "yarn@3.2.3"
}
